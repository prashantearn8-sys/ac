rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'coolbrosacservice@gmail.com' ||
        request.auth.token.email == 'burnster1826@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidServiceType(val) {
      return val is string && val.size() >= 2 && val.size() <= 80;
    }

    function isValidMessageSubject(val) {
      return val is string && val.size() <= 60 && (
        val == 'General AC Inquiry' ||
        val == 'Emergency Breakdown Support' ||
        val == 'Commercial / AMC Quote' ||
        val == 'Installation / Uninstallation Quote' ||
        val == 'Service Feedback'
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidServicePackage(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'tagline',
        'priceInr',
        'iconIndex',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'name',
        'tagline',
        'priceInr',
        'iconIndex',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.tagline is string && data.tagline.size() <= 200 &&
      data.priceInr is number && data.priceInr >= 49 && data.priceInr <= 500000 &&
      data.iconIndex is number && data.iconIndex >= 0 && data.iconIndex <= 5 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCustomerMessage(data) {
      return data.keys().hasAll([
        'userId',
        'senderName',
        'senderEmail',
        'locality',
        'acDetails',
        'subject',
        'messageText',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'userId',
        'senderName',
        'senderEmail',
        'locality',
        'acDetails',
        'subject',
        'messageText',
        'createdAt'
      ]) &&
      data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
      data.userId == request.auth.uid &&
      data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 100 &&
      data.senderEmail is string && data.senderEmail.size() >= 5 && data.senderEmail.size() <= 120 &&
      data.senderEmail == request.auth.token.email &&
      data.locality is string && data.locality.size() <= 200 &&
      data.acDetails is string && data.acDetails.size() <= 100 &&
      isValidMessageSubject(data.subject) &&
      data.messageText is string && data.messageText.size() >= 5 && data.messageText.size() <= 1000 &&
      data.createdAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
        'authorId',
        'authorName',
        'isVerifiedUser',
        'approved',
        'rating',
        'serviceUsed',
        'locality',
        'reviewText',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'authorId',
        'authorName',
        'isVerifiedUser',
        'approved',
        'rating',
        'serviceUsed',
        'locality',
        'reviewText',
        'createdAt'
      ]) &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
      data.isVerifiedUser is bool &&
      data.approved is bool &&
      data.rating is number && data.rating >= 1 && data.rating <= 5 &&
      isValidServiceType(data.serviceUsed) &&
      data.locality is string && data.locality.size() >= 2 && data.locality.size() <= 80 &&
      data.reviewText is string && data.reviewText.size() >= 5 && data.reviewText.size() <= 600 &&
      data.createdAt is timestamp;
    }

    // 4. Collection Rules: /services/{serviceId} (Publicly Readable Catalog, Admin-Only Write, No Admin Email Leak)
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;

      allow create: if isValidId(serviceId) &&
        isValidServicePackage(incoming()) &&
        incoming().id == serviceId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isValidId(serviceId) &&
        isValidServicePackage(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() && (
          incoming().diff(existing()).affectedKeys().hasOnly(['priceInr', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'tagline', 'priceInr', 'iconIndex', 'updatedAt'])
        );

      allow delete: if isValidId(serviceId) && isAdmin();
    }

    // 5. Collection Rules: /messages/{messageId} (Isolated to Sender or Admin)
    match /messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(messageId) &&
        isValidCustomerMessage(incoming()) &&
        incoming().createdAt == request.time;

      allow delete: if isVerifiedUser() &&
        isValidId(messageId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // 6. Collection Rules: /reviews/{reviewId} (Moderated Reviews: Public reads only approved == true)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().approved == true || isAdmin());
      allow list: if existing().approved == true || isAdmin();

      allow create: if isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().approved == isAdmin() && (
          (isSignedIn() && incoming().authorId == request.auth.uid && incoming().isVerifiedUser == (request.auth.token.email_verified == true)) ||
          (!isSignedIn() && incoming().authorId == 'guest' && incoming().isVerifiedUser == false)
        );

      allow update: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        isAdmin() &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['approved']);

      allow delete: if isVerifiedUser() &&
        isValidId(reviewId) && (
          isAdmin() ||
          (existing().authorId != 'guest' && existing().authorId == request.auth.uid)
        );
    }
  }
}
