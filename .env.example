# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email Notification Configuration for Cool Bros AC Service
# Destination inbox for customer messages and booking alerts (defaults to coolbrosacservice@gmail.com)
NOTIFY_EMAIL="coolbrosacservice@gmail.com"

# Optional SMTP Credentials (e.g., Gmail App Password) for direct SMTP delivery.
# If omitted, the server and client automatically fall back to FormSubmit AJAX email relay to coolbrosacservice@gmail.com.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
